<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0">
  <id>examples</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <files>
    <file>
      <source>${project.build.directory}/portable-pom.xml</source>
      <outputDirectory>/</outputDirectory>
      <destName>pom.xml</destName>
    </file>
    <file>
      <source>${project.basedir}/README.md</source>
      <outputDirectory>/</outputDirectory>
      <destName>README.md</destName>
    </file>
  </files>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/../../../../../</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>LICENSE</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../embedded-h2</directory>
      <outputDirectory>/embedded-h2</outputDirectory>
      <includes>
        <include>pom.xml</include>
      </includes>
      <fileMode>0644</fileMode>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../../../../../plugins/org.eclipse.emf.cdo.examples/src</directory>
      <outputDirectory>/embedded-h2/src/main/java</outputDirectory>
      <includes>
        <include>org/eclipse/emf/cdo/examples/plain/embedded/EmbeddedH2Example.java</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../remote-server</directory>
      <outputDirectory>/remote-server</outputDirectory>
      <includes>
        <include>pom.xml</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../../../../../plugins/org.eclipse.emf.cdo.examples/src</directory>
      <outputDirectory>/remote-server/src/main/java</outputDirectory>
      <includes>
        <include>org/eclipse/emf/cdo/examples/plain/server/RemoteServer.java</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../remote-client</directory>
      <outputDirectory>/remote-client</outputDirectory>
      <includes>
        <include>pom.xml</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/../../../../../plugins/org.eclipse.emf.cdo.examples/src</directory>
      <outputDirectory>/remote-client/src/main/java</outputDirectory>
      <includes>
        <include>org/eclipse/emf/cdo/examples/plain/client/RemoteClient.java</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
