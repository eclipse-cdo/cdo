<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0">
  <id>examples</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <files>
    <file>
      <source>${project.build.directory}/portable-examples/pom.xml</source>
      <outputDirectory>/</outputDirectory>
      <destName>pom.xml</destName>
    </file>
    <file>
      <source>${project.basedir}/README.md</source>
      <outputDirectory>/</outputDirectory>
      <destName>README.md</destName>
    </file>
  </files>
  <fileSets>
    <fileSet>
      <directory>${project.basedir}/../../../../../</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>LICENSE</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/portable-examples</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>*/pom.xml</include>
      </includes>
      <fileMode>0644</fileMode>
    </fileSet>
    <fileSet>
      <directory>${project.basedir}/..</directory>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>*/**</include>
      </includes>
      <excludes>
        <exclude>distribution/**</exclude>
        <exclude>*/pom.xml</exclude>
        <exclude>**/target/**</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/portable-examples/src/main/java</directory>
      <outputDirectory>/src/main/java</outputDirectory>
      <includes>
        <include>org/eclipse/emf/cdo/examples/plain/**/*.java</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
