<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.cdo.examples</groupId>
    <artifactId>cdo-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>configured-server</artifactId>

  <properties>
    <plain.java.source.file>org/eclipse/emf/cdo/examples/plain/server/ConfiguredWebSocketServerExtension.java</plain.java.source.file>
    <jetty.version>12.1.14</jetty.version>
    <cdo.db.url>jdbc:h2:file:${project.basedir}/data/cdo;AUTO_SERVER=TRUE</cdo.db.url>
  </properties>

  <profiles>
    <profile>
      <id>forward-server-password</id>
      <activation><property><name>cdo.db.password</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>cdo.db.password</key><value>${cdo.db.password}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-wss-truststore</id>
      <activation><property><name>cdo.wss.truststore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.trustStore</key><value>${cdo.wss.truststore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-wss-truststore-password</id>
      <activation><property><name>cdo.wss.truststore.password</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.trustStorePassword</key><value>${cdo.wss.truststore.password}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-ws-path</id>
      <activation><property><name>cdo.ws.path</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>cdo.ws.path</key><value>${cdo.ws.path}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-wss-keystore</id>
      <activation><property><name>cdo.wss.keystore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.keyStore</key><value>${cdo.wss.keystore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-wss-keystore-password</id>
      <activation><property><name>cdo.wss.keystore.password</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.keyStorePassword</key><value>${cdo.wss.keystore.password}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-net4j-ssl-key</id>
      <activation><property><name>cdo.ssl.keystore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>org.eclipse.net4j.tcp.ssl.key</key><value>${cdo.ssl.keystore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-net4j-ssl-trust</id>
      <activation><property><name>cdo.ssl.truststore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>org.eclipse.net4j.tcp.ssl.trust</key><value>${cdo.ssl.truststore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-net4j-ssl-passphrase</id>
      <activation><property><name>cdo.ssl.passphrase</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>org.eclipse.net4j.tcp.ssl.passphrase</key><value>${cdo.ssl.passphrase}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-ws-port</id>
      <activation><property><name>cdo.ws.port</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>cdo.ws.port</key><value>${cdo.ws.port}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>checkout-central-repository</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <properties>
        <cdo.maven.repository>${project.basedir}/../../../target/central/final</cdo.maven.repository>
      </properties>
      <repositories>
        <repository>
          <id>cdo-prepared-repository</id>
          <url>file:///${cdo.maven.repository}</url>
        </repository>
      </repositories>
    </profile>
    <profile>
      <id>postgresql</id>
      <properties>
        <db>postgresql</db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.cdo</groupId>
          <artifactId>org.eclipse.net4j.db.postgresql</artifactId>
        </dependency>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
          <version>${postgresql.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>checkout-source-copy</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.2</version>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.db</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.net4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.examples.company</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db.h2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.tcp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws.jetty.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.util</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>org.eclipse.emf.cdo.server.Main</mainClass>
          <systemProperties>
            <systemProperty>
              <key>net4j.config</key>
              <value>${project.basedir}/config</value>
            </systemProperty>
            <systemProperty><key>db</key><value>${db}</value></systemProperty>
            <systemProperty><key>transport</key><value>${transport}</value></systemProperty>
            <systemProperty><key>cdo.db.url</key><value>${cdo.db.url}</value></systemProperty>
            <systemProperty><key>cdo.db.server</key><value>${cdo.db.server}</value></systemProperty>
            <systemProperty><key>cdo.db.port</key><value>${cdo.db.port}</value></systemProperty>
            <systemProperty><key>cdo.db.database</key><value>${cdo.db.database}</value></systemProperty>
            <systemProperty><key>cdo.db.user</key><value>${cdo.db.user}</value></systemProperty>
            <systemProperty><key>cdo.ws.host</key><value>${cdo.ws.host}</value></systemProperty>
            <systemProperty>
              <key>org.eclipse.emf.cdo.internal.server.Repository.DISABLE_FEATURE_MAP_CHECKS</key>
              <value>true</value>
            </systemProperty>
            <systemProperty>
              <key>javax.net.ssl.keyStoreType</key>
              <value>${cdo.ssl.keystore.type}</value>
            </systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
