<project name="cdo-maven-aggregation" default="validate" basedir="." xmlns:if="ant:if">
	<description>Portable local CDO p2repo-aggregator workflow.</description>

	<!-- Override with -Dcbi.aggregator=<path-to-cbiAggrc.exe>. -->
	<property name="cbi.aggregator" value="cbiAggrc.exe" />
	<property name="maven.executable" value="mvn" />
	<property environment="env" />
	
	<!-- Regular package mode supports R, S, and I builds. -->
	<property name="publishing.mode" value="VALIDATE" />
	<property name="override.release.version" value="" />
	<property name="central.repository.url" value="https://repo.maven.apache.org/maven2/" />
	<property file="${basedir}/examples/distribution/package.properties" />
	
	
	<!-- Source cache used only to isolate and populate the consumer-test Maven repository. -->
	<property name="maven.local.repository" location="${user.home}/.m2/repository" />
	<tstamp>
		<format property="run.id" pattern="yyyyMMdd-HHmmss-SSS" />
	</tstamp>
	
	<!-- Pass -Dwork.dir=<directory> to retain all generated state there. Jenkins
	     uses $WORKSPACE/maven-publishing/work; local runs default to target/central. -->
	<condition property="explicit.work.dir">
		<isset property="work.dir" />
	</condition>
	<property name="default.work.dir" location="${basedir}/../target/central" />
	<property name="work.dir" location="${default.work.dir}" />
	<condition property="workspace.root" value="${env.CDO_WORKSPACE_ROOT}">
		<isset property="env.CDO_WORKSPACE_ROOT" />
	</condition>
	<property name="workspace.root" location="${basedir}/../target" />
	<condition property="build.root.option" value="--buildRoot &quot;${work.dir}/repository&quot;" else="">
		<isset property="explicit.work.dir" />
	</condition>
	
	<!-- Isolated Maven cache copied from the source cache before consumer runs. -->
	<property name="maven.consumer.repository" location="${work.dir}/maven-local" />
	<property name="classes.dir" location="${workspace.root}/.cdo-aggregation-helper/classes" />
	<condition property="default.build.root" value="${work.dir}/repository" else="${work.dir}">
		<isset property="explicit.work.dir" />
	</condition>
	<property name="build.root" location="${default.build.root}" />
	<property name="cdo.maven.repository" location="${build.root}/final" />
	<property name="configuration.dir" location="${work.dir}/configuration" />
	<property name="workspace.dir" location="${work.dir}/workspace" />
	<property name="metadata.file" location="${work.dir}/cdo-build-metadata.properties" />
	<property name="publishing.metadata.file" location="${basedir}/publishing.properties" />
	<property name="repositories.file" location="${work.dir}/cdo-validation-repositories.txt" />
	<property name="model.file" location="${basedir}/CDO.aggr" />
	<property name="consumer.work.dir" location="${work.dir}/consumer-test" />
	<property name="consumer.versions.file" location="${consumer.work.dir}/cdo-consumer-versions.properties" />
	<property name="consumer.project.dir" location="${basedir}/consumer-test" />
	<property name="consumer.central.only.dir" location="${work.dir}/consumer-central-only" />
	<property name="consumer.central.only.repository" location="${consumer.central.only.dir}/deployment-repository" />
	<property name="consumer.central.only.maven.repository" location="${consumer.central.only.dir}/maven-local" />
	<property name="consumer.central.only.versions.file" location="${consumer.central.only.dir}/cdo-consumer-versions.properties" />
	<property name="consumer.central.only.tree.file" location="${consumer.central.only.dir}/dependency-tree.txt" />
	<!-- Extra path depth keeps checkout-relative example profiles away from the source checkout. -->
	<property name="consumer.examples.dir" location="${work.dir}/consumer-standalone-examples/portable-check" />
	<property name="consumer.examples.maven.repository" location="${consumer.examples.dir}/maven-local" />
	<property name="consumer.examples.root" location="${consumer.examples.dir}/examples" />
	<property name="audit.report" location="${work.dir}/maven-central-readiness-audit.txt" />
	<property name="staging.dir" location="${work.dir}/staging" />
	<property name="bom436.repository" location="${work.dir}/bom-repository" />
	<property name="bom436.staging.dir" location="${work.dir}/bom-staging" />
	<property name="bom436.signed.repository" location="${work.dir}/bom-signed-repository" />

	<path id="helper.classpath">
		<pathelement location="${classes.dir}" />
	</path>

	<!-- The consumer test and dependency-tree invocation differ only in their
	     Maven goals. Keep the repository/version arguments in one portable
	     macro so both checks use exactly the same resolved coordinates. -->
	<macrodef name="run-consumer-maven">
		<attribute name="goals" />
		<sequential>
			<exec executable="${maven.executable}" dir="${consumer.project.dir}" failifexecutionfails="true" failonerror="true">
				<arg value="-Dmaven.repo.local=${maven.consumer.repository}" />
				<arg value="-Dcdo.maven.repository=${cdo.maven.repository}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.util=${cdo.version.org.eclipse.net4j.util}" />
				<arg value="-Dcdo.version.org.eclipse.net4j=${cdo.version.org.eclipse.net4j}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.tcp=${cdo.version.org.eclipse.net4j.tcp}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.db=${cdo.version.org.eclipse.net4j.db}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.db.jdbc=${cdo.version.org.eclipse.net4j.db.jdbc}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.db.h2=${cdo.version.org.eclipse.net4j.db.h2}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.common=${cdo.version.org.eclipse.emf.cdo.common}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo=${cdo.version.org.eclipse.emf.cdo}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.net4j=${cdo.version.org.eclipse.emf.cdo.net4j}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.server=${cdo.version.org.eclipse.emf.cdo.server}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.server.net4j=${cdo.version.org.eclipse.emf.cdo.server.net4j}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.server.db=${cdo.version.org.eclipse.emf.cdo.server.db}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.jvm=${cdo.version.org.eclipse.net4j.jvm}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.ws=${cdo.version.org.eclipse.net4j.ws}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.ws.jetty.server=${cdo.version.org.eclipse.net4j.ws.jetty.server}" />
				<arg value="-Dcdo.version.org.eclipse.net4j.db.postgresql=${cdo.version.org.eclipse.net4j.db.postgresql}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.server.embedded=${cdo.version.org.eclipse.emf.cdo.server.embedded}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.expressions=${cdo.version.org.eclipse.emf.cdo.expressions}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.security=${cdo.version.org.eclipse.emf.cdo.security}" />
				<arg value="-Dcdo.version.org.eclipse.emf.cdo.server.security=${cdo.version.org.eclipse.emf.cdo.server.security}" />
				<arg line="@{goals}" />
			</exec>
		</sequential>
	</macrodef>

	<target name="compile-helper">
		<condition property="workspace.root.absolute">
			<or>
				<matches string="${workspace.root}" pattern="^/.+" />
				<matches string="${workspace.root}" pattern="^[A-Za-z]:[/\\\\].+" />
			</or>
		</condition>
		<fail unless="workspace.root.absolute" message="workspace.root must be an absolute, non-root path before compiling the helper." />
		<fail message="workspace.root must be a non-empty, non-root path before compiling the helper.">
			<condition>
				<or>
					<equals arg1="${workspace.root}" arg2="" />
					<equals arg1="${workspace.root}" arg2="/" />
				</or>
			</condition>
		</fail>
		<mkdir dir="${classes.dir}" />
		<javac srcdir="${basedir}/../src" destdir="${classes.dir}" includeantruntime="false" source="11" target="11" encoding="UTF-8">
			<include name="org/eclipse/emf/cdo/releng/CDOAggregationTool.java" />
			<include name="org/eclipse/emf/cdo/releng/CentralVerificationTool.java" />
		</javac>
	</target>

	<target name="central-verify-prepare" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="central-verify-prepare" />
			<arg file="${central.verify.inventory}" />
			<arg file="${central.verify.bom}" />
			<arg file="${central.verify.consumer.pom}" />
			<arg file="${central.verify.tree}" />
			<arg file="${central.verify.resolved}" />
			<arg file="${central.verify.report}" />
		</java>
	</target>

	<target name="central-verify-inventory" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="derive-release-inventory" />
			<arg value="${central.verify.drop}" />
			<arg value="${central.verify.drop.id}" />
			<arg value="${central.verify.inventory}" />
			<arg value="${metadata.file}" />
		</java>
	</target>

	<target name="central-verify-maven">
		<exec executable="${maven.executable}" dir="${central.verify.dir}" failifexecutionfails="true" failonerror="true">
			<arg value="-B" />
			<arg value="-s" />
			<arg file="${central.verify.settings}" />
			<arg value="-Dmaven.repo.local=${central.verify.local.repository}" />
			<arg value="-f" />
			<arg file="${central.verify.consumer.pom}" />
			<arg value="org.apache.maven.plugins:maven-dependency-plugin:3.8.1:tree" />
			<arg value="-DoutputType=text" />
			<arg value="-DoutputFile=${central.verify.tree}" />
			<arg value="-Dverbose=false" />
			<arg value="org.apache.maven.plugins:maven-dependency-plugin:3.8.1:copy-dependencies" />
			<arg value="-DoutputDirectory=${central.verify.resolved}" />
			<arg value="-DincludeScope=runtime" />
		</exec>
	</target>

	<target name="central-verify-report" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="central-verify-report" />
			<arg file="${central.verify.inventory}" />
			<arg file="${central.verify.bom}" />
			<arg file="${central.verify.consumer.pom}" />
			<arg file="${central.verify.tree}" />
			<arg file="${central.verify.resolved}" />
			<arg file="${central.verify.report}" />
			<arg file="${central.verify.marker}" />
		</java>
	</target>

	<target name="central-verify-marker-shell-test">
		<exec executable="sh" failifexecutionfails="true" failonerror="true">
			<arg file="${basedir}/verify/publish-marker-remote-test.sh" />
		</exec>
	</target>

	<target name="validate-workspace" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="validate-workspace-path" />
			<arg value="${work.dir}" />
			<arg value="${workspace.root}" />
		</java>
	</target>

	<target name="publication-scope-check" depends="validate-workspace">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="publication-scope-check" />
			<arg value="${staging.dir}" />
			<arg value="${metadata.file}" />
		</java>
	</target>

	<target name="prepare" depends="validate-workspace">
		<echo message="Aggregation work directory: ${work.dir}" />
		<mkdir dir="${configuration.dir}" />
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="prepare" />
			<arg value="${cdo.drop.location}" />
			<arg value="${metadata.file}" />
			<arg value="${repositories.file}" />
			<arg value="${override.release.version}" />
		</java>
		<echo message="CDO drop location: ${cdo.drop.location}" />
		<echo message="Generated metadata: ${metadata.file}" />
		<echo message="Resolved validation repositories: ${repositories.file}" />
	</target>

	<target name="load-derived-values" depends="prepare">
		<property file="${metadata.file}" />
	</target>

	<target name="check-drop">
		<fail unless="cdo.drop.location" message="Required property cdo.drop.location was not supplied. Use -Dcdo.drop.location=&lt;local-drop-directory-or-http(s)-drop-url&gt;." />
		<condition property="cdo.drop.remote">
			<matches string="${cdo.drop.location}" pattern="(?i)^https?://.+" />
		</condition>
		<condition property="cdo.drop.available">
			<and>
				<not><isset property="cdo.drop.remote" /></not>
				<available file="${cdo.drop.location}" type="dir" />
			</and>
		</condition>
		<condition property="cdo.drop.valid">
			<or>
				<isset property="cdo.drop.remote" />
				<isset property="cdo.drop.available" />
			</or>
		</condition>
		<fail unless="cdo.drop.valid" message="cdo.drop.location must be an existing local directory or an HTTP(S) URL: ${cdo.drop.location}" />
	</target>

	<target name="check-console">
		<available file="${cbi.aggregator}" property="cbi.console.available" />
		<fail unless="cbi.console.available" message="Synchronous CBI console executable does not exist: ${cbi.aggregator}. Add -Dcbi.aggregator=&lt;path-to-cbiAggrc.exe&gt; (or put it on PATH)." />
	</target>

	<target name="execute-validate" depends="check-drop,check-console,load-derived-values">
		<exec executable="${cbi.aggregator}" failifexecutionfails="true" failonerror="true">
			<arg value="-configuration" />
			<arg value="${configuration.dir}" />
			<arg value="-data" />
			<arg value="${workspace.dir}" />
			<arg value="aggregate" />
			<arg value="--buildModel" />
			<arg value="${model.file}" />
			<arg value="--action" />
			<arg value="VALIDATE" />
			<arg line="${build.root.option}" />
			<arg value="-vmargs" />
			<arg value="-Dorg.eclipse.cbi.p2repo.cdo-location=${org.eclipse.cbi.p2repo.cdo-location}" />
			<arg value="-Dorg.eclipse.cbi.p2repo.simrel-location=${org.eclipse.cbi.p2repo.simrel-location}" />
		</exec>
	</target>

	<target name="execute-clean-build" depends="check-drop,check-console,load-derived-values">
		<exec executable="${cbi.aggregator}" failifexecutionfails="true" failonerror="true">
			<arg value="-configuration" />
			<arg value="${configuration.dir}" />
			<arg value="-data" />
			<arg value="${workspace.dir}" />
			<arg value="aggregate" />
			<arg value="--buildModel" />
			<arg value="${model.file}" />
			<arg value="--action" />
			<arg value="CLEAN_BUILD" />
			<arg line="${build.root.option}" />
			<arg value="-vmargs" />
			<arg value="-Dorg.eclipse.cbi.p2repo.cdo-location=${org.eclipse.cbi.p2repo.cdo-location}" />
			<arg value="-Dorg.eclipse.cbi.p2repo.simrel-location=${org.eclipse.cbi.p2repo.simrel-location}" />
		</exec>
	</target>

	<target name="native-classifier-validation" depends="execute-clean-build,compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="native-classifier-validation" />
			<arg value="${cdo.maven.repository}" />
			<arg value="${metadata.file}" />
		</java>
	</target>

	<target name="overlay" depends="validate-workspace,native-classifier-validation">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="overlay" />
			<arg value="${build.root}/final" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.metadata.file}" />
		</java>
	</target>

	<!-- Generates the regular project-release BOM from the selected drop's approved bundle artifacts. -->
	<target name="generate-bom" depends="verify,compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="generate-bom" />
			<arg value="${cdo.maven.repository}" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.metadata.file}" />
			<arg value="${work.dir}/bom-repository" />
			<arg value="${cdo.drop.location}" />
		</java>
	</target>

	<target name="stage-release-bom" if="package.release.bom">
		<antcall target="generate-bom" />
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="stage-release-bom" />
			<arg value="${work.dir}/bom-repository" />
			<arg value="${metadata.file}" />
			<arg value="${staging.dir}" />
		</java>
	</target>

	<!-- One-time CDO 4.36 retrofit path: derives its expected versions from the selected release drop. -->
	<target name="bom-436-prepare" depends="prepare,compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="generate-bom-436" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.metadata.file}" />
			<arg value="${bom436.repository}" />
			<arg value="${cdo.drop.location}" />
		</java>
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="stage-bom-436" />
			<arg value="${bom436.repository}" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.metadata.file}" />
			<arg value="${cdo.drop.location}" />
			<arg value="${bom436.staging.dir}" />
		</java>
	</target>

	<target name="check-bom-436-central" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="check-bom-central" />
			<arg value="${metadata.file}" />
			<arg value="${cdo.drop.location}" />
			<arg value="${central.repository.url}" />
		</java>
	</target>

	<target name="verify-bom-436-package" depends="validate-workspace,compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="verify-bom-package" />
			<arg value="${bom436.staging.dir}" />
			<arg value="${bom436.signed.repository}" />
			<arg value="${deployment.zip}" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.metadata.file}" />
			<arg value="${cdo.drop.location}" />
			<arg value="${gpg.expected.fingerprint}" />
			<arg value="${gpg.public.key.file}" />
			<arg value="${gpg.executable}" />
			<arg value="${work.dir}/bom-436-package-summary.properties" />
		</java>
	</target>

	<!-- Read-only Central classification report; no signing or deployment staging occurs here. -->
	<target name="classify-central" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="classify-central" />
			<arg value="${cdo.maven.repository}" />
			<arg value="${work.dir}/bom-repository" />
			<arg value="${metadata.file}" />
			<arg value="${work.dir}/central-coordinate-classification.properties" />
			<arg value="${central.repository.url}" />
			<arg value="${staging.dir}" />
		</java>
	</target>

	<target name="incremental-package" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="incremental-package" />
			<arg value="${staging.dir}" />
			<arg value="${work.dir}/central-coordinate-classification.properties" />
			<arg value="${deployment.zip}" />
			<arg value="${gpg.expected.fingerprint}" />
			<arg value="${gpg.public.key.file}" />
			<arg value="${gpg.executable}" />
			<arg value="${work.dir}/incremental-publication-summary.properties" />
		</java>
	</target>

	<target name="verify" depends="overlay">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="verify" />
			<arg value="${build.root}/final" />
			<arg value="${metadata.file}" />
		</java>
	</target>

	<target name="platform-version-range-test" depends="compile-helper">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="platform-version-range-test" />
		</java>
	</target>

	<target name="checksums" depends="verify">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="checksums" />
			<arg value="${cdo.maven.repository}" />
		</java>
		<echo message="Preserved or generated and validated classifier checksums in ${cdo.maven.repository}" />
	</target>

	<target name="prepare-maven-local" depends="validate-workspace">
		<available file="${maven.local.repository}" type="dir" property="maven.cache.available" />
		<fail unless="maven.cache.available" message="maven.local.repository is not a valid directory: ${maven.local.repository}" />
		<copy todir="${maven.consumer.repository}" overwrite="false" includeEmptyDirs="false">
			<fileset dir="${maven.local.repository}" />
		</copy>
	</target>

	<target name="audit" depends="checksums">
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="audit" />
			<arg value="${cdo.maven.repository}" />
			<arg value="${metadata.file}" />
			<arg value="${audit.report}" />
			<arg value="${staging.dir}" />
		</java>
		<copy file="${publishing.metadata.file}" todir="${staging.dir}" overwrite="true" />
		<echo message="Maven Central readiness audit passed; staging is ${staging.dir}" />
	</target>

	<target name="staging-validate" depends="audit,compile-helper">
		<condition property="package.examples.distribution">
			<equals arg1="${publishing.mode}" arg2="PACKAGE" />
		</condition>
		<condition property="package.release.bom">
			<equals arg1="${publishing.mode}" arg2="PACKAGE" />
		</condition>
		<antcall target="stage-examples-distribution" />
		<antcall target="stage-release-bom" />
		<java classname="org.eclipse.emf.cdo.releng.CDOAggregationTool" fork="true" failonerror="true" classpathref="helper.classpath">
			<arg value="publish-check" />
			<arg value="${staging.dir}" />
			<arg value="${metadata.file}" />
			<arg value="${publishing.mode}" />
			<arg value="" />
		</java>
		<echo message="Validated Maven Central staging package: ${staging.dir}" />
	</target>

