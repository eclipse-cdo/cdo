final String CBI_AGGREGATOR_URL = 'https://download.eclipse.org/cbi/updates/p2-aggregator/products/milestone/S202311221637/org.eclipse.cbi.p2repo.cli.product-linux.gtk.x86_64.tar.gz'
final String CBI_AGGREGATOR_SHA256 = 'CF641C257B800018372A057DE0961C3824322527D2A245C26BC16B9DF9F17454'
final String PUBLISH_CREDENTIALS_ID = 'cdo-maven-central-publish'
final String GPG_KEY_CREDENTIALS_ID = 'cdo-maven-central-gpg-key-id'
final String GPG_PASSPHRASE_CREDENTIALS_ID = 'cdo-maven-central-gpg-passphrase'
final String MAVEN_UPLOADER = 'disabled-until-approved'

pipeline {
  agent any

  options {
    timeout(time: 120, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    ant 'apache-ant-latest'
    jdk 'temurin-jdk21-latest'
    maven 'apache-maven-latest'
  }

  parameters {
    choice(name: 'PUBLISHING_MODE', choices: ['VALIDATE_ONLY', 'DRY_RUN', 'PUBLISH'],
      description: 'Technical validation/staging mode. PUBLISH is R-only and remains uploader-gated.')
    string(name: 'CDO_DROP_DIR', defaultValue: '', description: 'Directory containing build-info.xml and tp-macro.setup')
  }

  stages {
    stage('Aggregate and validate') {
      steps {
        script {
          if (!params.CDO_DROP_DIR?.trim()) {
            error('CDO_DROP_DIR is required')
          }
          def workDir = "${env.WORKSPACE}/maven-publishing"
          def aggregator
          def cbiDir = "${env.WORKSPACE}/cbi"
          withEnv(["CBI_URL=${CBI_AGGREGATOR_URL}", "CBI_SHA256=${CBI_AGGREGATOR_SHA256}", "CBI_DIR=${cbiDir}"]) {
              aggregator = sh(returnStdout: true, script: '''
                set -eu
                mkdir -p "$CBI_DIR/image"
                archive="$CBI_DIR/distribution"
                curl --fail --location --retry 3 --silent --show-error "$CBI_URL" -o "$archive"
                printf '%s  %s\\n' "$CBI_SHA256" "$archive" | sha256sum --check --status -
                case "$CBI_URL" in
                  *.zip) unzip -q "$archive" -d "$CBI_DIR/image" ;;
                  *.tar.gz|*.tgz) tar -xzf "$archive" -C "$CBI_DIR/image" ;;
                  *.tar.xz) tar -xJf "$archive" -C "$CBI_DIR/image" ;;
                  *) echo "Unsupported CBI archive format; use .zip, .tar.gz, .tgz, or .tar.xz" >&2; exit 2 ;;
                esac
                candidate=$(find "$CBI_DIR/image" -type f \( -name cbiAggrc -o -name cbiAggr \) -print -quit)
                if [ -z "$candidate" ]; then
                  echo "Pinned CBI archive does not contain cbiAggr or cbiAggrc" >&2
                  exit 3
                fi
                chmod +x "$candidate"
                printf '%s\\n' "$candidate"
              ''').trim()
            }
          }
          withEnv(["CDO_DROP_DIR=${params.CDO_DROP_DIR}", "AGGR_WORK_DIR=${workDir}", "CBI_AGGREGATOR=${aggregator}", "PUBLISHING_MODE=${params.PUBLISHING_MODE}"]) {
          withAnt(installation: 'apache-ant-latest') {
            sh '''
              set -eu
              ant -Dcdo.drop.dir="$CDO_DROP_DIR" -Dwork.dir="$AGGR_WORK_DIR" \
                -Dcbi.aggregator="$CBI_AGGREGATOR" -Dpublishing.mode="$PUBLISHING_MODE" \
                -f publish/aggr/build.xml clean-build consumer-dependency-tree
            '''
          }
          }
        }
      }
    }

    stage('Publishing boundary') {
      when {
        expression { params.PUBLISHING_MODE == 'PUBLISH' }
      }
      steps {
        script {
          def workDir = "${env.WORKSPACE}/maven-publishing"
          withEnv(["CDO_DROP_DIR=${params.CDO_DROP_DIR}", "AGGR_WORK_DIR=${workDir}", "MAVEN_UPLOADER=${MAVEN_UPLOADER}"]) {
          withCredentials([
            usernamePassword(credentialsId: PUBLISH_CREDENTIALS_ID,
              usernameVariable: 'MAVEN_CENTRAL_USERNAME', passwordVariable: 'MAVEN_CENTRAL_PASSWORD'),
            string(credentialsId: GPG_KEY_CREDENTIALS_ID, variable: 'MAVEN_GPG_KEY_ID'),
            string(credentialsId: GPG_PASSPHRASE_CREDENTIALS_ID, variable: 'MAVEN_GPG_PASSPHRASE')]) {
            withAnt(installation: 'apache-ant-latest') {
              sh '''
                set -eu
                ant -Dpublishing.mode=PUBLISH -Dcdo.drop.dir="$CDO_DROP_DIR" \
                  -Dwork.dir="$AGGR_WORK_DIR" \
                  -Dmaven.uploader="$MAVEN_UPLOADER" -f publish/aggr/build.xml publish
              '''
            }
          }
          }
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'maven-publishing/**/maven-publishing-summary.properties',
        allowEmptyArchive: true
    }
  }
}
