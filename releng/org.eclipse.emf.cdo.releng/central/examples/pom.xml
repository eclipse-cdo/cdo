<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.eclipse.cdo.examples</groupId>
  <artifactId>cdo-examples</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <modules>
    <module>embedded-h2</module>
    <module>remote-server</module>
    <module>configured-server</module>
    <module>remote-client</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <exec-maven-plugin.version>3.7.0</exec-maven-plugin.version>
    <maven-antrun-plugin.version>3.2.0</maven-antrun-plugin.version>
    <cdo.project.release>4.37.0</cdo.project.release>
    <h2.version>2.5.252</h2.version>
    <postgresql.version>42.7.13</postgresql.version>
    <db>h2</db>
    <transport>tcp</transport>
    <cdo.db.server>localhost</cdo.db.server>
    <cdo.db.port>5432</cdo.db.port>
    <cdo.db.database>cdo</cdo.db.database>
    <cdo.db.user>cdo</cdo.db.user>
    <cdo.ssl.keystore.type>PKCS12</cdo.ssl.keystore.type>
    <cdo.ws.host>0.0.0.0</cdo.ws.host>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.eclipse.cdo</groupId>
        <artifactId>org.eclipse.cdo.bom</artifactId>
        <version>${cdo.project.release}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <profiles>
    <profile>
      <id>cdo-deployment-repository</id>
      <activation>
        <property>
          <name>cdo.deployment.repository</name>
        </property>
      </activation>
      <repositories>
        <repository>
          <id>cdo-deployment-bundle</id>
          <url>${cdo.deployment.repository}</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
        <repository>
          <id>central</id>
          <url>https://repo.maven.apache.org/maven2</url>
          <releases>
            <enabled>true</enabled>
          </releases>
          <snapshots>
            <enabled>false</enabled>
          </snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>

  <build>
    <sourceDirectory>${project.basedir}/../src/main/java</sourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
          <includes>
            <include>${plain.java.source.file}</include>
          </includes>
        </configuration>
      </plugin>
    </plugins>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
          <executions>
            <execution>
              <id>copy-plain-java-source</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>copy-resources</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.directory}/generated-sources/plain-java</outputDirectory>
                <resources>
                  <resource>
                    <directory>${maven.multiModuleProjectDirectory}/plugins/org.eclipse.emf.cdo.examples/src</directory>
                    <filtering>false</filtering>
                    <includes>
                      <include>${plain.java.source.file}</include>
                    </includes>
                  </resource>
                </resources>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.2</version>
          <executions>
            <execution>
              <id>add-plain-java-source</id>
              <phase>generate-sources</phase>
              <goals>
                <goal>add-source</goal>
              </goals>
              <configuration>
                <sources>
                  <source>${project.build.directory}/generated-sources/plain-java</source>
                </sources>
              </configuration>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
