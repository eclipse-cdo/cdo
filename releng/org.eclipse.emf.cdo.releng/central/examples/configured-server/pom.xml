<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.cdo.examples</groupId>
    <artifactId>cdo-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>configured-server</artifactId>

  <properties>
    <plain.java.source.file>org/eclipse/emf/cdo/examples/plain/server/ConfiguredWebSocketServerExtension.java</plain.java.source.file>
    <jetty.version>12.1.14</jetty.version>
  </properties>

  <profiles>
    <profile>
      <id>forward-cdo-db-url</id>
      <activation>
        <property>
          <name>cdo.db.url</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cdo.db.url>${cdo.db.url}</cdo.db.url>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>forward-cdo-db-server</id>
      <activation>
        <property>
          <name>cdo.db.server</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cdo.db.server>${cdo.db.server}</cdo.db.server>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>forward-cdo-db-port</id>
      <activation>
        <property>
          <name>cdo.db.port</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cdo.db.port>${cdo.db.port}</cdo.db.port>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>forward-cdo-db-database</id>
      <activation>
        <property>
          <name>cdo.db.database</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cdo.db.database>${cdo.db.database}</cdo.db.database>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>forward-cdo-db-user</id>
      <activation>
        <property>
          <name>cdo.db.user</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <configuration>
              <systemPropertyVariables>
                <cdo.db.user>${cdo.db.user}</cdo.db.user>
              </systemPropertyVariables>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>checkout-central-repository</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <properties>
        <cdo.maven.repository>${project.basedir}/../../../target/central/final</cdo.maven.repository>
      </properties>
      <repositories>
        <repository>
          <id>cdo-prepared-repository</id>
          <url>file:///${cdo.maven.repository}</url>
        </repository>
      </repositories>
    </profile>
    <profile>
      <id>postgresql</id>
      <properties>
        <db>postgresql</db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.cdo</groupId>
          <artifactId>org.eclipse.net4j.db.postgresql</artifactId>
          <version>${cdo.net4j.postgresql.version}</version>
        </dependency>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
          <version>${postgresql.version}</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>checkout-source-copy</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.2</version>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.db</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.net4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.examples.company</artifactId>
      <version>${cdo.company.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db.h2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.tcp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws.jetty.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.util</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>org.eclipse.emf.cdo.server.Main</mainClass>
          <systemPropertyVariables>
            <db>${db}</db>
            <transport>${transport}</transport>
            <cdo.db.password>${cdo.db.password}</cdo.db.password>
            <javax.net.ssl.keyStore>${cdo.wss.keystore}</javax.net.ssl.keyStore>
            <javax.net.ssl.keyStorePassword>${cdo.wss.keystore.password}</javax.net.ssl.keyStorePassword>
            <javax.net.ssl.keyStoreType>${cdo.ssl.keystore.type}</javax.net.ssl.keyStoreType>
            <cdo.ws.host>${cdo.ws.host}</cdo.ws.host>
            <cdo.ws.port>${cdo.ws.port}</cdo.ws.port>
            <org.eclipse.net4j.tcp.ssl.key>${cdo.ssl.keystore}</org.eclipse.net4j.tcp.ssl.key>
            <org.eclipse.net4j.tcp.ssl.trust>${cdo.ssl.truststore}</org.eclipse.net4j.tcp.ssl.trust>
            <org.eclipse.net4j.tcp.ssl.passphrase>${cdo.ssl.passphrase}</org.eclipse.net4j.tcp.ssl.passphrase>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
