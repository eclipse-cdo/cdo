<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.cdo.examples</groupId>
    <artifactId>cdo-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>configured-server</artifactId>

  <properties>
    <plain.java.source.file>org/eclipse/emf/cdo/examples/plain/server/ConfiguredWebSocketServerExtension.java</plain.java.source.file>
    <jetty.version>12.1.14</jetty.version>
    <cdo.db.url>jdbc:h2:file:${project.basedir}/data/cdo;AUTO_SERVER=TRUE</cdo.db.url>
    <exec.arg.db.password></exec.arg.db.password>
    <exec.arg.wss.truststore></exec.arg.wss.truststore>
    <exec.arg.wss.truststore.password></exec.arg.wss.truststore.password>
    <exec.arg.ws.path></exec.arg.ws.path>
    <exec.arg.wss.keystore></exec.arg.wss.keystore>
    <exec.arg.wss.keystore.password></exec.arg.wss.keystore.password>
    <exec.arg.ssl.keystore></exec.arg.ssl.keystore>
    <exec.arg.ssl.truststore></exec.arg.ssl.truststore>
    <exec.arg.ssl.passphrase></exec.arg.ssl.passphrase>
    <exec.arg.ws.port></exec.arg.ws.port>
  </properties>

  <profiles>
    <profile>
      <id>forward-server-password</id>
      <activation>
        <property>
          <name>cdo.db.password</name>
        </property>
      </activation>
      <properties>
        <exec.arg.db.password>-Dcdo.db.password="${cdo.db.password}"</exec.arg.db.password>
      </properties>
    </profile>

    <profile>
      <id>forward-wss-truststore</id>
      <activation>
        <property>
          <name>cdo.wss.truststore</name>
        </property>
      </activation>
      <properties>
        <exec.arg.wss.truststore>-Djavax.net.ssl.trustStore="${cdo.wss.truststore}"</exec.arg.wss.truststore>
      </properties>
    </profile>

    <profile>
      <id>forward-wss-truststore-password</id>
      <activation>
        <property>
          <name>cdo.wss.truststore.password</name>
        </property>
      </activation>
      <properties>
        <exec.arg.wss.truststore.password>-Djavax.net.ssl.trustStorePassword="${cdo.wss.truststore.password}"</exec.arg.wss.truststore.password>
      </properties>
    </profile>

    <profile>
      <id>forward-ws-path</id>
      <activation>
        <property>
          <name>cdo.ws.path</name>
        </property>
      </activation>
      <properties>
        <exec.arg.ws.path>-Dcdo.ws.path="${cdo.ws.path}"</exec.arg.ws.path>
      </properties>
    </profile>

    <profile>
      <id>forward-wss-keystore</id>
      <activation>
        <property>
          <name>cdo.wss.keystore</name>
        </property>
      </activation>
      <properties>
        <exec.arg.wss.keystore>-Djavax.net.ssl.keyStore="${cdo.wss.keystore}"</exec.arg.wss.keystore>
      </properties>
    </profile>

    <profile>
      <id>forward-wss-keystore-password</id>
      <activation>
        <property>
          <name>cdo.wss.keystore.password</name>
        </property>
      </activation>
      <properties>
        <exec.arg.wss.keystore.password>-Djavax.net.ssl.keyStorePassword="${cdo.wss.keystore.password}"</exec.arg.wss.keystore.password>
      </properties>
    </profile>

    <profile>
      <id>forward-net4j-ssl-key</id>
      <activation>
        <property>
          <name>cdo.ssl.keystore</name>
        </property>
      </activation>
      <properties>
        <exec.arg.ssl.keystore>-Dorg.eclipse.net4j.tcp.ssl.key="${cdo.ssl.keystore}"</exec.arg.ssl.keystore>
      </properties>
    </profile>

    <profile>
      <id>forward-net4j-ssl-trust</id>
      <activation>
        <property>
          <name>cdo.ssl.truststore</name>
        </property>
      </activation>
      <properties>
        <exec.arg.ssl.truststore>-Dorg.eclipse.net4j.tcp.ssl.trust="${cdo.ssl.truststore}"</exec.arg.ssl.truststore>
      </properties>
    </profile>

    <profile>
      <id>forward-net4j-ssl-passphrase</id>
      <activation>
        <property>
          <name>cdo.ssl.passphrase</name>
        </property>
      </activation>
      <properties>
        <exec.arg.ssl.passphrase>-Dorg.eclipse.net4j.tcp.ssl.passphrase="${cdo.ssl.passphrase}"</exec.arg.ssl.passphrase>
      </properties>
    </profile>

    <profile>
      <id>forward-ws-port</id>
      <activation>
        <property>
          <name>cdo.ws.port</name>
        </property>
      </activation>
      <properties>
        <exec.arg.ws.port>-Dcdo.ws.port="${cdo.ws.port}"</exec.arg.ws.port>
      </properties>
    </profile>

    <profile>
      <id>checkout-central-repository</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <properties>
        <cdo.maven.repository>${project.basedir}/../../../target/central/final</cdo.maven.repository>
      </properties>
      <repositories>
        <repository>
          <id>cdo-prepared-repository</id>
          <url>file:///${cdo.maven.repository}</url>
        </repository>
      </repositories>
    </profile>

    <profile>
      <id>postgresql</id>
      <properties>
        <db>postgresql</db>
      </properties>
      <dependencies>
        <dependency>
          <groupId>org.eclipse.cdo</groupId>
          <artifactId>org.eclipse.net4j.db.postgresql</artifactId>
        </dependency>
        <dependency>
          <groupId>org.postgresql</groupId>
          <artifactId>postgresql</artifactId>
          <version>${postgresql.version}</version>
        </dependency>
      </dependencies>
    </profile>

    <profile>
      <id>checkout-source-copy</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.2</version>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.db</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.net4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.examples.company</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db.h2</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.tcp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws.jetty.server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty</groupId>
      <artifactId>jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jetty.websocket</groupId>
      <artifactId>jetty-websocket-jetty-server</artifactId>
      <version>${jetty.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>2.0.17</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.util</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-resources-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
        <configuration>
          <archive>
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <executable>java</executable>
          <workingDirectory>${user.dir}</workingDirectory>
          <inheritIo>true</inheritIo>
          <commandlineArgs>
            -classpath
            %classpath
            -Dnet4j.config="${project.basedir}/config"
            -Ddb="${db}"
            -Dtransport="${transport}"
            -Dcdo.db.url="${cdo.db.url}"
            -Dcdo.db.server="${cdo.db.server}"
            -Dcdo.db.port="${cdo.db.port}"
            -Dcdo.db.database="${cdo.db.database}"
            -Dcdo.db.user="${cdo.db.user}"
            -Dcdo.ws.host="${cdo.ws.host}"
            -Djavax.net.ssl.keyStoreType="${cdo.ssl.keystore.type}"
            -Dorg.eclipse.emf.cdo.internal.server.Repository.DISABLE_FEATURE_MAP_CHECKS=true
            ${exec.arg.db.password}
            ${exec.arg.wss.truststore}
            ${exec.arg.wss.truststore.password}
            ${exec.arg.ws.path}
            ${exec.arg.wss.keystore}
            ${exec.arg.wss.keystore.password}
            ${exec.arg.ssl.keystore}
            ${exec.arg.ssl.truststore}
            ${exec.arg.ssl.passphrase}
            ${exec.arg.ws.port}
            org.eclipse.emf.cdo.server.Main
            ${exec.arg.application}
          </commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
