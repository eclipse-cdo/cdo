<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="org.eclipse.net4j.db">
<annotation>
      <appInfo>
         <meta.schema plugin="org.eclipse.net4j.db" id="dbAdapters" name="Net4j DB Adapters"/>
      </appInfo>
      <documentation>
         Contributes database adapters to the Net4j DB registry. Recognition metadata is read from the contribution before its adapter class is instantiated, so JDBC connections can be matched lazily from database product names and optional driver-name and URL constraints. A product name must match an exact name or product-name pattern, and every configured driver-name and URL constraint must also match.
      </documentation>
   </annotation>

   <element name="extension">
      <complexType>
         <sequence>
            <element ref="dbAdapter" minOccurs="1" maxOccurs="unbounded"/>
         </sequence>
         <attribute name="point" type="string" use="required">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string">
            <annotation>
               <documentation>

               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="dbAdapter">
      <complexType>
         <attribute name="name" type="string" use="required">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="version" type="string" use="required">
            <annotation>
               <documentation>

               </documentation>
            </annotation>
         </attribute>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>

               </documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn="org.eclipse.net4j.db.IDBAdapter:"/>
               </appInfo>
            </annotation>
         </attribute>
         <attribute name="productNames" type="string" use="optional">
            <annotation>
               <documentation>
                  Comma-separated exact JDBC database product names. Names are trimmed and matched case-insensitively. If omitted, the adapter's declared name is used. Use productNamePattern for product names that contain commas.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="productNamePattern" type="string" use="optional">
            <annotation>
               <documentation>
                  Optional Java regular expression matched case-insensitively against the complete trimmed JDBC product name. It supplements the exact productNames matches.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="driverNamePattern" type="string" use="optional">
            <annotation>
               <documentation>
                  Optional Java regular expression matched case-insensitively against the complete trimmed JDBC driver name. When present, the driver name must be available and match.
               </documentation>
            </annotation>
         </attribute>
         <attribute name="urlPattern" type="string" use="optional">
            <annotation>
               <documentation>
                  Optional Java regular expression matched case-insensitively against the complete trimmed JDBC URL. When present, the URL must be available and match.
               </documentation>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <annotation>
      <appInfo>
         <meta.section type="since"/>
      </appInfo>
      <documentation>
         [Enter the first release in which this extension point appears.]
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="examples"/>
      </appInfo>
      <documentation>
         [Enter extension point usage example here.]
      </documentation>
   </annotation>

   <annotation>
