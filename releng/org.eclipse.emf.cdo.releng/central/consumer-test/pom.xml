<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.eclipse.cdo.releng</groupId>
  <artifactId>cdo-maven-consumer-test</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <properties>
    <maven.compiler.release>11</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <cdo.maven.repository>${project.basedir}/../work/repository/final</cdo.maven.repository>
    <junit.version>4.13.2</junit.version>
    <h2.version>2.4.240</h2.version>
  </properties>

  <repositories>
    <repository>
      <id>cdo-local</id>
      <url>file:///${cdo.maven.repository}</url>
    </repository>
    <repository>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.util</artifactId>
      <version>${cdo.version.org.eclipse.net4j.util}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j</artifactId>
      <version>${cdo.version.org.eclipse.net4j}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.tcp</artifactId>
      <version>${cdo.version.org.eclipse.net4j.tcp}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db</artifactId>
      <version>${cdo.version.org.eclipse.net4j.db}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db.jdbc</artifactId>
      <version>${cdo.version.org.eclipse.net4j.db.jdbc}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.db.h2</artifactId>
      <version>${cdo.version.org.eclipse.net4j.db.h2}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.common</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo.common}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.net4j</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo.net4j}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo.server}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.net4j</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo.server.net4j}</version>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.server.db</artifactId>
      <version>${cdo.version.org.eclipse.emf.cdo.server.db}</version>
    </dependency>

    <!-- Deliberately explicit: the aggregator does not publish JDBC drivers. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>${h2.version}</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
      </plugin>
    </plugins>
  </build>
</project>
