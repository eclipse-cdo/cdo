<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.eclipse.cdo.examples</groupId>
    <artifactId>cdo-examples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>remote-client</artifactId>

  <properties>
    <plain.java.source.file>org/eclipse/emf/cdo/examples/plain/client/RemoteClient.java</plain.java.source.file>
  </properties>

  <profiles>
    <profile>
      <id>forward-wss-truststore</id>
      <activation><property><name>cdo.wss.truststore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.trustStore</key><value>${cdo.wss.truststore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-wss-truststore-password</id>
      <activation><property><name>cdo.wss.truststore.password</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>javax.net.ssl.trustStorePassword</key><value>${cdo.wss.truststore.password}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-net4j-ssl-trust</id>
      <activation><property><name>cdo.ssl.truststore</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>org.eclipse.net4j.tcp.ssl.trust</key><value>${cdo.ssl.truststore}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-net4j-ssl-passphrase</id>
      <activation><property><name>cdo.ssl.passphrase</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>org.eclipse.net4j.tcp.ssl.passphrase</key><value>${cdo.ssl.passphrase}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>forward-ws-path</id>
      <activation><property><name>cdo.ws.path</name></property></activation>
      <build><plugins><plugin>
        <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
        <configuration><systemProperties combine.children="append"><systemProperty>
          <key>cdo.ws.path</key><value>${cdo.ws.path}</value>
        </systemProperty></systemProperties></configuration>
      </plugin></plugins></build>
    </profile>
    <profile>
      <id>checkout-central-repository</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <properties>
        <cdo.maven.repository>${project.basedir}/../../../target/central/final</cdo.maven.repository>
      </properties>
      <repositories>
        <repository>
          <id>cdo-prepared-repository</id>
          <url>file:///${cdo.maven.repository}</url>
        </repository>
      </repositories>
    </profile>
    <profile>
      <id>checkout-source-copy</id>
      <activation>
        <file>
          <exists>../../../../../plugins/org.eclipse.emf.cdo.examples/src</exists>
        </file>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.5.0</version>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <version>3.6.2</version>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.net4j</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.emf.cdo.examples.company</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.tcp</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.ws</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.cdo</groupId>
      <artifactId>org.eclipse.net4j.util</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>17</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <configuration>
          <mainClass>org.eclipse.emf.cdo.examples.plain.client.RemoteClient</mainClass>
          <systemProperties>
            <systemProperty><key>transport</key><value>${transport}</value></systemProperty>
          </systemProperties>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
