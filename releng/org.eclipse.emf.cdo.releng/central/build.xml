		</java>
		<loadfile property="consumer.examples.repository.url" srcFile="${consumer.examples.dir}/deployment-repository-url.txt" />
		<macrodef name="check-portable-example-profiles">
			<attribute name="module" />
			<sequential>
				<exec executable="${maven.executable}" dir="${consumer.examples.root}/@{module}" failifexecutionfails="true" failonerror="true" output="${consumer.examples.dir}/active-profiles-@{module}.txt">
					<arg value="-gs" />
					<arg value="${basedir}/standalone-examples-settings.xml" />
					<arg value="-s" />
					<arg value="${basedir}/standalone-examples-settings.xml" />
					<arg value="-Dmaven.repo.local=${consumer.examples.maven.repository}" />
					<arg value="-Dcdo.deployment.repository=${consumer.examples.repository.url}" />
					<arg value="help:active-profiles" />
					<env key="CDO_DEPLOYMENT_REPOSITORY" value="${consumer.examples.repository.url}" />
					<env key="CDO_CENTRAL_REPOSITORY" value="${central.repository.url}" />
				</exec>
				<loadfile property="active.profiles.@{module}" srcFile="${consumer.examples.dir}/active-profiles-@{module}.txt" />
				<condition property="checkout.profile.active.@{module}">
					<or>
						<contains string="${active.profiles.@{module}}" substring="checkout-central-repository" />
						<contains string="${active.profiles.@{module}}" substring="checkout-source-copy" />
					</or>
				</condition>
				<fail if="checkout.profile.active.@{module}" message="A checkout-specific profile is active for packaged module @{module}" />
			</sequential>
		</macrodef>
		<check-portable-example-profiles module="embedded-h2" />
		<check-portable-example-profiles module="remote-server" />
		<check-portable-example-profiles module="remote-client" />
		<exec executable="${maven.executable}" dir="${consumer.examples.root}" failifexecutionfails="true" failonerror="true">
			<arg value="-gs" />
			<arg value="${basedir}/standalone-examples-settings.xml" />
			<arg value="-s" />
			<arg value="${basedir}/standalone-examples-settings.xml" />
			<arg value="-Dmaven.repo.local=${consumer.examples.maven.repository}" />
