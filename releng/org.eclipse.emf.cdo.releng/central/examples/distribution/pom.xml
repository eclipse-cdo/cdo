<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>org.eclipse.cdo</groupId>
  <artifactId>cdo-examples-distribution</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2000-01-01T00:00:00Z</project.build.outputTimestamp>
  </properties>

  <name>CDO Plain Java Examples Distribution</name>
  <description>Self-contained ZIP distribution of the CDO Plain Java examples</description>
  <url>https://eclipse.dev/cdo/</url>
  <organization>
    <name>Eclipse Foundation</name>
    <url>https://www.eclipse.org</url>
  </organization>
  <licenses>
    <license>
      <name>EPL-2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <name>Eclipse CDO Project</name>
      <url>https://github.com/eclipse-cdo/cdo/graphs/contributors</url>
    </developer>
  </developers>
  <scm>
    <connection>scm:git:https://github.com/eclipse-cdo/cdo.git</connection>
    <developerConnection>scm:git:https://github.com/eclipse-cdo/cdo.git</developerConnection>
    <url>https://eclipse.dev/cdo/</url>
    <tag>HEAD</tag>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/eclipse-cdo/cdo/issues</url>
  </issueManagement>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.2.0</version>
        <executions>
          <execution>
            <id>prepare-portable-examples</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <target>
                <delete dir="${project.build.directory}/portable-examples"/>
                <mkdir dir="${project.build.directory}/portable-examples"/>
                <xslt in="${project.basedir}/../pom.xml" out="${project.build.directory}/portable-examples/pom.xml"
                  style="${project.basedir}/portable-pom.xsl"/>
                <xslt basedir="${project.basedir}/.." includes="*/pom.xml" excludes="distribution/pom.xml"
                  style="${project.basedir}/portable-pom.xsl" destdir="${project.build.directory}/portable-examples" extension=".xml"/>
                <copy todir="${project.build.directory}/portable-examples/src/main/java">
                  <fileset dir="${project.basedir}/../../../../../plugins/org.eclipse.emf.cdo.examples/src">
                    <include name="org/eclipse/emf/cdo/examples/plain/**/*.java"/>
                  </fileset>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>examples-zip</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <appendAssemblyId>true</appendAssemblyId>
              <descriptors>
                <descriptor>${project.basedir}/assembly.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
